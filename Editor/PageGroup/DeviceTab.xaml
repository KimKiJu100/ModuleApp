<dxr:RibbonPage x:Class="Editor.PageGroup.DeviceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:local="clr-namespace:Editor.PageGroup"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Caption="Device">

    <dxr:RibbonPageGroup Caption="Device Files">
        
        <dxb:BarButtonItem Content="Save"
            RibbonStyle="Large"
            LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
            Glyph="{dx:DXImage Image=Save_16x16.png}"
            Command="{Binding OpenWizardCommand}">
        </dxb:BarButtonItem>
        
        <dxb:BarButtonItem Content="Open"
            RibbonStyle="Large"
            LargeGlyph="{dx:DXImage Image=Open_32x32.png}"
            Glyph="{dx:DXImage Image=Open_16x16.png}"
            Command="{Binding SaveCommand}">
        </dxb:BarButtonItem>
    </dxr:RibbonPageGroup>

    <dxr:RibbonPageGroup Caption="Device Editor">
        <dxb:BarButtonItem Content="View"
        RibbonStyle="Large"
        LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
        Glyph="{dx:DXImage Image=Edit_16x16.png}"
        Command="{Binding OpenWizardCommand}">
        </dxb:BarButtonItem>
    </dxr:RibbonPageGroup>
</dxr:RibbonPage>
