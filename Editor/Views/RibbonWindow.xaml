<dx:ThemedWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:prism ="http://prismlibrary.com/"
    xmlns:core="clr-namespace:Editor.Core;assembly=Editor.Core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    x:Class="Editor.Views.RibbonWindow"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="RibbonWindow" Height="800" Width="1000">

    <DockPanel LastChildFill="True">
        <dxr:RibbonControl DockPanel.Dock="Top" RibbonStyle="Office2019" prism:RegionManager.RegionName="{x:Static core:RegionNames.RibbonRegion}">
            
        </dxr:RibbonControl>

        <!--<ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />-->

        <dxdo:DockLayoutManager prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}">
            <dxdo:LayoutGroup Caption="LayoutRoot">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel Caption="Panel1"/>
                    <dxdo:LayoutPanel Caption="Panel2"/>
                </dxdo:LayoutGroup>
                <dxdo:LayoutPanel Caption="Panel3"/>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>



        <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom"/>
        <dxe:ImageEdit Height="587" VerticalAlignment="Top" Width="150" Source="{dx:DXImage SvgImages/Dashboards/Edit.svg}"/>
    </DockPanel>
</dx:ThemedWindow>
